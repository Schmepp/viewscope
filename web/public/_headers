# Cloudflare Pages response headers.
#
# Pages applies every matching rule and concatenates same-named headers, so
# the patterns below must not overlap: a `/data/*` catch-all alongside a
# `/data/manifest.json` rule emits one contradictory Cache-Control listing
# both max-ages. The blobs have stable filenames and are only safe to cache
# hard because the manifest that describes them revalidates every load.

/data/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/data/*.bin
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
