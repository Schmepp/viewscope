{
  "name": "viewscope-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ViewScope: browser port of the PySide6 + VTK desktop viewer",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "export-data": "cd .. && python scripts/export_web_bundle.py",
    "deploy": "npm run build && wrangler pages deploy dist --project-name viewscope"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "wrangler": "^4.48.1"
  }
}
